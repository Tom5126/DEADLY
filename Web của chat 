  // Chia mục tiêu thành nhiều giai đoạn cùng lúc (mỗi dòng một bước)
  function openBulkMilestones(goal) {
    openModal('Chia mục tiêu thành các giai đoạn', `
      <p class="muted small">Mỗi dòng là một giai đoạn, theo thứ tự thực hiện. Sau đó bạn có thể gán từng giai đoạn vào một ngày cụ thể.</p>
      <label class="field"><span>Các giai đoạn</span><textarea name="lines" rows="8" placeholder="Tìm tài liệu&#10;Xây dựng mô hình nghiên cứu&#10;Thiết kế bảng hỏi&#10;Thu thập dữ liệu&#10;Viết báo cáo"></textarea></label>`,
    data => {
      const lines = data.lines.split('\n').map(l => l.replace(/^\s*(?:[-*•]|\d+[.)])\s*/, '').trim()).filter(Boolean);
      if (!lines.length) { toast('Hãy nhập ít nhất một giai đoạn'); return false; }
      lines.forEach(title => goal.milestones.push({ id: Store.uid(), title, status: 'todo', date: '' }));
      Store.save(); route(); toast(`Đã thêm ${lines.length} giai đoạn`);
    }, 'Thêm giai đoạn');
  }

  function openMilestoneForm(goal, ms) {
    const editing = !!ms;
    const m = { title: '', date: '', ...(ms || {}) };
    openModal(editing ? 'Sửa giai đoạn' : 'Thêm giai đoạn', `
      <label class="field"><span>Tên giai đoạn</span><input name="title" required maxlength="140" value="${esc(m.title)}"></label>
      <label class="field"><span>Ngày thực hiện (không bắt buộc)</span><input type="date" name="date" value="${m.date}"></label>`,
