  /* ==========================================================
     TRANG: CÔNG VIỆC
     ========================================================== */
  function filterTasks(f) {
    const today = D.today(), wk = weekDates(today);
    return Store.tasks.filter(t => {
      switch (f) {
        case 'pending': return !t.done;
        case 'done': return t.done;
        case 'overdue': return isOverdue(t);
        case 'today': return t.date === today;
        case 'week': return t.date >= wk[0] && t.date <= wk[6];
        default: return true;
      }
    });
  }

  function renderTasks() {
    const list = filterTasks(state.taskFilter);
    const sorters = {
      date: byDateTime,
      priority: (a, b) => PRI_ORDER[a.priority] - PRI_ORDER[b.priority] || byDateTime(a, b),
      goal: (a, b) => {
        const ga = goalOf(a), gb = goalOf(b);
        return (ga ? ga.title : '\uffff').localeCompare(gb ? gb.title : '\uffff') || byDateTime(a, b);
      }
    };
    list.sort(sorters[state.taskSort]);

    view.innerHTML = pageHead('Công việc', `${list.length} công việc`, '<button class="btn primary" data-action="add-task">+ Thêm công việc</button>') + `
      <div class="toolbar">
        <div class="filters">${FILTERS.map(([k, label]) => `<button class="chip ${state.taskFilter === k ? 'active' : ''}" data-action="filter" data-filter="${k}">${label}</button>`).join('')}</div>
        <label class="sort">Sắp xếp
          <select id="sort-select" class="input">
            <option value="date" ${state.taskSort === 'date' ? 'selected' : ''}>Theo ngày</option>
            <option value="priority" ${state.taskSort === 'priority' ? 'selected' : ''}>Theo mức độ ưu tiên</option>
            <option value="goal" ${state.taskSort === 'goal' ? 'selected' : ''}>Theo mục tiêu</option>
          </select>
        </label>
      </div>
      <section class="card">
        ${list.length ? taskList(list, true) : emptyState('🎉', 'Không có công việc nào trong bộ lọc này.')}
      </section>`;
  }

  /* ==========================================================
     TRANG: LỊCH CỦA TÔI (Day / Week)
     ========================================================== */
  function renderCalendar() {
    const { calMode: mode, calDate: date } = state;
    let title, body;
    if (mode === 'day') {
      title = `${D.dayName(date)}, ${D.fmt(date)}`;
      const tasks = Store.tasks.filter(t => t.date === date).sort(byTime);
      body = `
      <div class="cols">
        <section class="card">
          <div class="card-head"><h2>🗓️ Lịch trong ngày</h2><button class="btn sm primary" data-action="add-event" data-date="${date}">+ Thêm lịch</button></div>
          ${timelineHTML(date)}
        </section>
        <section class="card">
          <div class="card-head"><h2>✅ Công việc</h2><button class="btn sm" data-action="add-task" data-date="${date}">+ Thêm việc</button></div>
          ${tasks.length ? taskList(tasks) : emptyState('🗒️', 'Chưa có công việc trong ngày này.')}
        </section>
      </div>`;
    } else {
      const days = weekDates(date), today = D.today();
      title = `Tuần ${D.fmt(days[0]).slice(0, 5)} – ${D.fmt(days[6])}`;
      const count = (d, k) => Store.events.filter(e => e.date === d && e.category === k).length + Store.tasks.filter(t => t.date === d && taskCat(t) === k).length;
      const rows = Object.keys(CATS).map(k => ({ k, counts: days.map(d => count(d, k)) })).filter(r => r.counts.some(n => n > 0));
      const head = d => `<button class="week-head ${d === today ? 'today' : ''}" data-action="cal-goto" data-date="${d}">${D.short(d)}<small>${d.slice(8)}/${d.slice(5, 7)}</small></button>`;
      body = `
      <section class="card">
        <div class="scroll-x">
          <table class="week-table">
            <thead><tr><th></th>${days.map(d => `<th>${head(d)}</th>`).join('')}</tr></thead>
            <tbody>${rows.length ? rows.map(r => `<tr><th scope="row">${CATS[r.k].icon} ${CATS[r.k].name}</th>${r.counts.map(n => `<td class="${n ? '' : 'zero'}">${n}</td>`).join('')}</tr>`).join('')
              : `<tr><td colspan="8" class="zero">Tuần này chưa có lịch hay công việc.</td></tr>`}</tbody>
          </table>
        </div>
      </section>
      <div class="scroll-x">
        <div class="week-board">${days.map(d => {
          const evs = Store.events.filter(e => e.date === d).sort((a, b) => a.start.localeCompare(b.start));
          const ts = Store.tasks.filter(t => t.date === d).sort(byTime);
          return `<div class="week-col ${d === today ? 'today' : ''}">
            ${head(d)}
            ${evs.map(e => `<div class="wk-item">⏰ <b>${e.start}</b> ${esc(e.title)}</div>`).join('')}
            ${ts.map(t => `<div class="wk-item ${t.done ? 'done' : ''}">${t.done ? '☑' : '☐'} ${esc(t.title)}</div>`).join('')}
            ${!evs.length && !ts.length ? '<div class="wk-empty">Trống</div>' : ''}
          </div>`;
        }).join('')}</div>
      </div>`;
    }

    view.innerHTML = pageHead('Lịch của tôi', title, `
      <div class="seg">
        <button class="${mode === 'day' ? 'active' : ''}" data-action="cal-mode" data-mode="day">Ngày</button>
        <button class="${mode === 'week' ? 'active' : ''}" data-action="cal-mode" data-mode="week">Tuần</button>
      </div>
      <div class="seg">
        <button data-action="cal-nav" data-dir="-1" aria-label="Trước">‹</button>
        <button data-action="cal-nav" data-dir="0">Hôm nay</button>
        <button data-action="cal-nav" data-dir="1" aria-label="Sau">›</button>
      </div>`) + body;
  }

  /* ==========================================================
     TRANG: TIẾN ĐỘ (thống kê + Chart.js)
     ========================================================== */
  function renderProgress() {
    const totalGoals = Store.goals.length;
    const doneGoals = Store.goals.filter(goalDone).length;
    const doneTasks = Store.tasks.filter(t => t.done).length;
    view.innerHTML = pageHead('Tiến độ', 'Theo dõi hiệu suất cá nhân của bạn') + `
      <div class="stats">
        ${stat('Tổng số mục tiêu', totalGoals)}
        ${stat('Mục tiêu hoàn thành', doneGoals)}
        ${stat('Công việc hoàn thành', doneTasks)}
        ${stat('Chuỗi ngày làm việc', `${Store.streak()} ngày 🔥`)}
      </div>
      <section class="card">
        <div class="card-head"><h2>Công việc hoàn thành trong 7 ngày</h2></div>
        <div class="chart-wrap"><canvas id="chart7"></canvas></div>
      </section>
      <section class="card">
        <div class="card-head"><h2>Tiến độ từng mục tiêu</h2></div>
        ${Store.goals.length ? `<ul class="mini-goals">${Store.goals.map(g => `
          <li style="--c:${g.color}"><a href="#goal/${g.id}">${esc(g.title)}</a>${deadlineBadge(g.deadline, goalDone(g))}${progressBar(Store.goalStats(g).pct)}</li>`).join('')}</ul>`
          : emptyState('🎯', 'Chưa có mục tiêu nào để theo dõi.')}
      </section>`;
    drawChart();
  }

  function drawChart() {
    const canvas = $('#chart7');
    if (!canvas) return;
    if (typeof Chart === 'undefined') {
      canvas.parentElement.innerHTML = '<p class="muted">Không tải được Chart.js — hãy kiểm tra kết nối Internet.</p>';
      return;
    }
    const days = Array.from({ length: 7 }, (_, i) => D.add(D.today(), i - 6));
    const data = days.map(d => Store.tasks.filter(t => t.done && t.doneDate === d).length);
    const css = getComputedStyle(document.documentElement);
    const accent = css.getPropertyValue('--accent').trim(), muted = css.getPropertyValue('--muted').trim(), grid = css.getPropertyValue('--border').trim();
    state.chart = new Chart(canvas, {
      type: 'bar',
      data: { labels: days.map(d => `${D.short(d)} ${d.slice(8)}/${d.slice(5, 7)}`), datasets: [{ label: 'Công việc hoàn thành', data, backgroundColor: accent, borderRadius: 8, maxBarThickness: 40 }] },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          y: { beginAtZero: true, ticks: { precision: 0, color: muted }, grid: { color: grid } },
          x: { ticks: { color: muted }, grid: { display: false } }
        }
      }
    });
  }

  /* ==========================================================
     TRANG: CÀI ĐẶT
     ========================================================== */
  function renderSettings() {
    const s = Store.settings;
    view.innerHTML = pageHead('Cài đặt') + `
      <section class="card settings">
        <div class="set-row"><div><h3>Tên của bạn</h3><p class="muted small">Hiển thị trong lời chào ở trang Hôm nay.</p></div>
          <input class="input" data-setting="name" value="${esc(s.name)}" maxlength="40" placeholder="Nhập tên"></div>
        <div class="set-row"><div><h3>Giao diện</h3><p class="muted small">Chọn nền sáng hoặc tối.</p></div>
          <select class="input" data-setting="theme"><option value="light" ${s.theme === 'light' ? 'selected' : ''}>Sáng</option><option value="dark" ${s.theme === 'dark' ? 'selected' : ''}>Tối</option></select></div>
        <div class="set-row"><div><h3>Thông báo</h3><p class="muted small">Nhắc số việc còn lại và việc quá hạn khi bạn mở DAYGO mỗi ngày.</p></div>
          <label class="switch"><input type="checkbox" data-setting="notifications" ${s.notifications ? 'checked' : ''}><span></span></label></div>
        <div class="set-row"><div><h3>Ngày bắt đầu tuần</h3><p class="muted small">Dùng cho Lịch tuần và bộ lọc “Tuần này”.</p></div>
          <select class="input" data-setting="weekStart"><option value="1" ${Number(s.weekStart) === 1 ? 'selected' : ''}>Thứ Hai</option><option value="0" ${Number(s.weekStart) === 0 ? 'selected' : ''}>Chủ Nhật</option></select></div>
      </section>
      <section class="card settings">
        <div class="set-row"><div><h3>Reset dữ liệu demo</h3><p class="muted small">Thay dữ liệu hiện tại bằng mục tiêu, công việc và lịch mẫu.</p></div>
          <button class="btn" data-action="reset-demo">Reset demo</button></div>
        <div class="set-row"><div><h3>Xóa toàn bộ dữ liệu</h3><p class="muted small">Xóa mục tiêu, công việc và lịch. Cài đặt được giữ lại.</p></div>
          <button class="btn danger" data-action="clear-all">Xóa tất cả</button></div>
      </section>`;
  }

  /* ---------- Giao diện sáng/tối ---------- */
  function applyTheme() {
    const dark = Store.settings.theme === 'dark';
    document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    $('#theme-ico').textContent = dark ? '☀️' : '🌙';
    $('#theme-label').textContent = dark ? 'Giao diện sáng' : 'Giao diện tối';
  }

  /* ---------- Thông báo trình duyệt ---------- */
  async function enableNotifications(on) {
    if (on) {
      if (!('Notification' in window)) { toast('Trình duyệt này không hỗ trợ thông báo'); return false; }
      const perm = await Notification.requestPermission();
      if (perm !== 'granted') { toast('Bạn chưa cho phép thông báo trong trình duyệt'); return false; }
    }
    Store.settings.notifications = on; Store.saveSettings();
    return true;
  }
  function maybeNotify() {
    if (!Store.settings.notifications || !('Notification' in window) || Notification.permission !== 'granted') return;
    const today = D.today();
    if (Store.read('daygo_notified', '') === today) return;      // mỗi ngày chỉ nhắc một lần
    const left = Store.tasks.filter(t => t.date === today && !t.done).length;
    const over = Store.tasks.filter(isOverdue).length;
    if (!left && !over) return;
    new Notification('DAYGO', { body: `Hôm nay còn ${left} việc${over ? `, ${over} việc quá hạn` : ''}.` });
    Store.write('daygo_notified', today);
  }

  /* ==========================================================
     ĐIỀU HƯỚNG (router)
     ========================================================== */
  function route() {
    if (state.chart) { state.chart.destroy(); state.chart = null; }
    const [name, param] = (location.hash.replace('#', '') || 'today').split('/');
    $$('.sidebar nav a').forEach(a => a.classList.toggle('active', a.dataset.nav === (name === 'goal' ? 'goals' : name)));
    const pages = { today: renderToday, calendar: renderCalendar, goals: renderGoals, goal: () => renderGoalDetail(param), tasks: renderTasks, progress: renderProgress, settings: renderSettings };
    (pages[name] || renderToday)();
    closeSidebar();
  }
  const openSidebar = () => { $('#sidebar').classList.add('open'); $('#scrim').classList.add('show'); };
  const closeSidebar = () => { $('#sidebar').classList.remove('open'); $('#scrim').classList.remove('show'); };

  /* ==========================================================
     SỰ KIỆN: một bộ lắng nghe chung cho mọi nút có data-action
     ========================================================== */
  document.addEventListener('click', e => {
    if (e.target === modalEl) { closeModal(); return; }              // bấm nền mờ để đóng modal
    const el = e.target.closest('[data-action]');
    if (!el) return;
    const { action, id } = el.dataset;
    const goal = Store.goals.find(g => g.id === el.dataset.goal);
    const ms = goal && goal.milestones.find(m => m.id === id);

    switch (action) {
      // --- Công việc ---
      case 'toggle-task': toggleTask(id); break;
      case 'add-task': openTaskForm(null, { date: el.dataset.date || D.today(), goalId: el.dataset.goal || '' }); break;
      case 'edit-task': openTaskForm(Store.tasks.find(t => t.id === id)); break;
      case 'del-task':
        confirmBox('Xóa công việc?', 'Công việc này sẽ bị xóa vĩnh viễn.', () => { Store.tasks = Store.tasks.filter(t => t.id !== id); Store.save(); route(); toast('Đã xóa công việc'); });
        break;

      // --- Mục tiêu ---
      case 'add-goal': openGoalForm(); break;
      case 'edit-goal': openGoalForm(Store.goals.find(g => g.id === id)); break;
      case 'del-goal':
        confirmBox('Xóa mục tiêu?', 'Mục tiêu và các giai đoạn sẽ bị xóa. Công việc thuộc mục tiêu vẫn được giữ lại nhưng không còn gắn với mục tiêu.', () => {
          Store.goals = Store.goals.filter(g => g.id !== id);
          Store.tasks.forEach(t => { if (t.goalId === id) { t.goalId = ''; t.milestoneId = ''; } });
          Store.save(); go('#goals'); toast('Đã xóa mục tiêu');
        });
        break;

      // --- Giai đoạn (milestone) ---
      case 'add-ms': openMilestoneForm(goal); break;
      case 'bulk-ms': openBulkMilestones(goal); break;
      case 'edit-ms': openMilestoneForm(goal, ms); break;
      case 'del-ms':
        confirmBox('Xóa giai đoạn?', 'Giai đoạn sẽ bị xóa. Các công việc đã gán vẫn được giữ lại.', () => {
          goal.milestones = goal.milestones.filter(m => m.id !== id);
          Store.tasks.forEach(t => { if (t.milestoneId === id) t.milestoneId = ''; });
          Store.save(); route();
        });
        break;
      case 'cycle-ms': ms.status = MS_NEXT[ms.status]; Store.save(); route(); break;
      case 'plan-ms': openTaskForm(null, { title: ms.title, goalId: goal.id, milestoneId: ms.id, date: ms.date || D.today() }); break;

      // --- Lịch ---
      case 'add-event': openEventForm(null, el.dataset.date); break;
      case 'edit-event': openEventForm(Store.events.find(x => x.id === id)); break;
      case 'del-event':
        confirmBox('Xóa lịch?', 'Mục lịch này sẽ bị xóa.', () => { Store.events = Store.events.filter(x => x.id !== id); Store.save(); route(); toast('Đã xóa lịch'); });
        break;
      case 'cal-mode': state.calMode = el.dataset.mode; route(); break;
      case 'cal-goto': state.calDate = el.dataset.date; state.calMode = 'day'; route(); break;
      case 'cal-nav': {
        const dir = Number(el.dataset.dir), step = state.calMode === 'week' ? 7 : 1;
        state.calDate = dir === 0 ? D.today() : D.add(state.calDate, dir * step);
        route(); break;
      }

      // --- Khác ---
      case 'filter': state.taskFilter = el.dataset.filter; route(); break;
      case 'goto-overdue': state.taskFilter = 'overdue'; go('#tasks'); break;
      case 'close-modal': closeModal(); break;
      case 'toggle-theme':
        Store.settings.theme = Store.settings.theme === 'dark' ? 'light' : 'dark';
        Store.saveSettings(); applyTheme(); route(); break;
      case 'reset-demo':
        confirmBox('Reset dữ liệu demo?', 'Dữ liệu hiện tại sẽ được thay bằng dữ liệu mẫu.', () => { Store.loadDemo(); route(); toast('Đã khôi phục dữ liệu demo'); });
        break;
      case 'clear-all':
        confirmBox('Xóa toàn bộ dữ liệu?', 'Tất cả mục tiêu, công việc và lịch sẽ bị xóa vĩnh viễn.', () => { Store.clearAll(); route(); toast('Đã xóa toàn bộ dữ liệu'); });
        break;
    }
  });

  // Các ô nhập/chọn: sắp xếp công việc + Cài đặt
  document.addEventListener('change', async e => {
    const el = e.target;
    if (el.id === 'sort-select') { state.taskSort = el.value; route(); return; }
    const key = el.dataset.setting;
    if (!key) return;
    if (key === 'notifications') {
      const ok = await enableNotifications(el.checked);
      if (!ok) el.checked = false;
      return;
    }
    Store.settings[key] = key === 'weekStart' ? Number(el.value) : el.value.trim();
    Store.saveSettings();
    if (key === 'theme') applyTheme();
    toast('Đã lưu cài đặt');
  });

  document.addEventListener('keydown', e => { if (e.key === 'Escape') { closeModal(); closeSidebar(); } });
  $('#menu-btn').addEventListener('click', openSidebar);
  $('#scrim').addEventListener('click', closeSidebar);
  window.addEventListener('hashchange', () => { route(); window.scrollTo(0, 0); });

  /* ---------- Khởi động ---------- */
  Store.load();
  applyTheme();
  route();
  maybeNotify();
})();
  </script>
</body>
</html>