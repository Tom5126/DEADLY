  function openEventForm(ev, date) {
    const editing = !!ev;
    const e = { title: '', date: date || D.today(), start: '09:00', end: '10:00', category: 'study', ...(ev || {}) };
    openModal(editing ? 'Sửa lịch' : 'Thêm lịch', `
