    data => {
      if (!data.title.trim()) { toast('Hãy nhập tên mục tiêu'); return false; }
      if (data.deadline < data.start) { toast('Deadline phải sau ngày bắt đầu'); return false; }
      const patch = { title: data.title.trim(), desc: data.desc.trim(), category: data.category, priority: data.priority, start: data.start, deadline: data.deadline, color: data.color || COLORS[0] };
      if (editing) { Object.assign(goal, patch); Store.save(); route(); toast('Đã cập nhật mục tiêu'); return; }
      const ng = { id: Store.uid(), ...patch, milestones: [] };
      Store.goals.push(ng); Store.save(); go('#goal/' + ng.id);
      toast('Đã tạo mục tiêu — hãy chia nhỏ thành các giai đoạn');
      openBulkMilestones(ng);   // gợi ý ngay: chia mục tiêu thành các bước
